# Flutter --dart-define 변수 목록
# 실제 값을 채운 뒤 .env 로 복사하거나 build.sh 에서 직접 사용하세요.
# 이 파일(.env.example)은 커밋하고, .env 는 절대 커밋하지 마세요.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
TWELVE_DATA_API_KEY=your_twelve_data_key

# Supabase Edge Function 환경변수 (supabase secrets set 으로 주입)
# VAULT_URL=https://your-vault-project.supabase.co
# VAULT_SERVICE_KEY=your_vault_service_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
